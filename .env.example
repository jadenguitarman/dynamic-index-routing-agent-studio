# Algolia application ID.
ALGOLIA_APPLICATION_ID=
# Search-scoped or secured key for runtime Agent Studio completions. Keep it server-side.
ALGOLIA_AGENT_STUDIO_API_KEY=
# Server-only Agent Studio management key with settings/editSettings ACLs for create/update/publish.
ALGOLIA_AGENT_STUDIO_MANAGEMENT_API_KEY=
# Server-only indexing key with addObject, settings, and editSettings ACLs.
ALGOLIA_INDEXING_API_KEY=
# The product catalog index you supply.
ALGOLIA_PRODUCT_INDEX=
# Created and seeded by npm run provision.
ALGOLIA_SUPPORT_INDEX=agent_studio_support_demo
# Direct Agent Studio agent ID.
AGENT_STUDIO_AGENT_ID=
# Required only when the script creates a new agent.
AGENT_STUDIO_PROVIDER_ID=
AGENT_STUDIO_MODEL=
AGENT_STUDIO_AGENT_NAME=Dynamic index routing demo
PUBLISH_AGENTS=false
# Comma-separated approved index names for the server-side route map.
ALGOLIA_INDEX_ALLOWLIST=
PORT=3000
